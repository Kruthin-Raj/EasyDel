{
  "name": "@delivery/database",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "node scripts/guard-destructive.mjs \"prisma db push\" && prisma db push",
    "db:migrate": "node scripts/guard-destructive.mjs \"prisma migrate dev\" && prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "node scripts/guard-destructive.mjs \"prisma migrate reset\" && prisma migrate reset",
    "db:migrate:new": "node scripts/new-migration.mjs",
    "db:make-admin": "node scripts/make-admin.mjs",
    "test:fixtures": "node scripts/test-fixtures.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^6.4.1",
    "typescript": "^5.0.0"
  }
}
